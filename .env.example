# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (Neon / Supabase / Railway / local Docker).
DATABASE_URL="postgresql://user:password@localhost:5432/resin?schema=public"
# Used only by Playwright. Must be a separate database; the e2e web server
# builds and boots against it.
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/resin_test?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random bytes. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-32-random-bytes"

# Owner account, hashed at seed time (never stored in plain text).
ADMIN_EMAIL="ash@example.com"
ADMIN_PASSWORD="replace-with-a-long-password"

# ── Image storage ───────────────────────────────────────────────────────────
# Set ONE of these. Cloudinary: Dashboard → API environment variable.
CLOUDINARY_URL="cloudinary://key:secret@cloud-name"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Email (optional) ────────────────────────────────────────────────────────
RESEND_API_KEY=""

# ── Public site config ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://resinbyash.pk"
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"
NEXT_PUBLIC_WHATSAPP_DISPLAY="+92 300 1234567"
# Optional: Google Business Profile URL included in Store sameAs once verified.
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=""

# ── Analytics (optional) ────────────────────────────────────────────────────
# GA4 measurement ID, for example G-XXXXXXXXXX. The consent banner only shows
# when this is set.
NEXT_PUBLIC_GA_ID=""

# ── Security ────────────────────────────────────────────────────────────────
# Set to 1 for one staging day to observe the CSP without blocking anything.
CSP_REPORT_ONLY="0"
