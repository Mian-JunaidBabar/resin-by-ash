// Prisma schema for Resin by Ash.
// Source of truth for the database. Mirrors lib/types.ts (domain types).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  LIVE
  DRAFT
  HIDDEN
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RequestStatus {
  NEW
  QUOTED
  ACCEPTED
  DECLINED
}

enum AdminRole {
  OWNER
  DEVELOPER
}

enum CategoryStatus {
  LIVE
  HIDDEN
}

/// Dynamic categories: a tree (parentId null = top level). Every LIVE node has its own page:
/// /shop/{slug} for top level, /shop/{parent}/{slug} for children.
model Category {
  id              String             @id @default(cuid())
  slug            String
  parent          Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  parentId        String?
  children        Category[]         @relation("CategoryTree")
  name            String
  shortName       String
  h1              String?
  intro           String             @default("")
  metaTitle       String?
  metaDescription String?
  seoContent      String?
  faq             Json?
  imageUrl        String?
  ogImageUrl      String?
  tone            String             @default("#F1EBE4")
  showOnHome      Boolean            @default(true)
  showInFooter    Boolean            @default(true)
  sortOrder       Int                @default(0)
  status          CategoryStatus     @default(LIVE)
  products        Product[]
  redirects       CategoryRedirect[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([parentId, slug])
  @@index([status, parentId, sortOrder])
}

/// Created automatically when a category slug or parent changes; old URL → 308 to the new one.
model CategoryRedirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  createdAt  DateTime @default(now())
}

model Product {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  category        Category         @relation(fields: [categoryId], references: [id])
  categoryId      String
  description     String
  details         String
  care            String
  price           Int
  salePrice       Int?
  saleEndsAt      DateTime?
  images          ProductImage[]
  variants        ProductVariant[]
  toneBg          String           @default("#F1EBE4")
  toneAccent      String           @default("#E9B8BE")
  customisable    Boolean          @default(false)
  personalisation String[]         @default([])
  occasions       String[]         @default([])
  leadTime        String           @default("5–7 working days")
  pinnedBestSeller Boolean         @default(false)
  pinOrder        Int?
  showInLatest    Boolean          @default(false)
  status          ProductStatus    @default(DRAFT)
  orderLines      OrderLine[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, categoryId])
  @@index([pinnedBestSeller, pinOrder])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  alt       String?
  width     Int?
  height    Int?
  isVideo   Boolean @default(false)
  position  Int     @default(0)

  @@index([productId, position])
}

model ProductVariant {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  kind       String // "size" | "colour"
  name       String
  swatch     String?
  priceDelta Int     @default(0)
  position   Int     @default(0)

  @@unique([productId, kind, name])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique // normalised 03XXXXXXXXX
  city      String?
  address   String?
  tag       String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String        @id @default(cuid())
  /// Sequence `order_number_seq` starts at 1047; shown as `{orderPrefix}{number}`.
  number          Int           @unique @default(dbgenerated("nextval('order_number_seq'::regclass)"))
  customer        Customer      @relation(fields: [customerId], references: [id])
  customerId      String
  name            String
  phone           String
  city            String
  address         String
  notes           String?
  privateNote     String?
  subtotal        Int // after sale prices
  savings         Int
  delivery        Int
  total           Int
  payment         String        @default("COD")
  status          OrderStatus   @default(NEW)
  shipBy          DateTime?
  whatsappMessage String
  lines           OrderLine[]
  events          OrderEvent[]
  progressPhotos  String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

model OrderLine {
  id              String   @id @default(cuid())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId         String
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId       String?
  name            String // snapshot
  size            String?
  colour          String?
  personalisation Json     @default("{}")
  qty             Int
  unitPrice       Int
  unitWas         Int
}

model OrderEvent {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  label     String
  createdAt DateTime @default(now())
}

model CustomRequest {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String
  city         String?
  item         String
  occasionDate DateTime?
  budget       String
  colours      String[]      @default([])
  description  String
  imageUrls    String[]      @default([])
  status       RequestStatus @default(NEW)
  quote        Int?
  readyBy      DateTime?
  orderId      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  contact   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

model DeliveryZone {
  id       String @id @default(cuid())
  label    String
  cities   String[]
  charge   Int
  days     String
  position Int    @default(0)
}

model Settings {
  id                   Int     @id @default(1)
  whatsappNumber       String
  whatsappDisplay      String
  instagram            String  @default("")
  tiktok               String  @default("")
  studioHours          String  @default("")
  announcementOn       Boolean @default(true)
  announcement         String  @default("")
  orderPrefix          String  @default("RBA-")
  defaultLeadTime      String  @default("5–7 working days")
  orderMessageTemplate String
  acceptCod            Boolean @default(true)
  heroImageUrl         String?
  heroHeadline         String?
  searchSynonyms       Json?
  faq                  Json?
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         AdminRole @default(OWNER)
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String    @id @default(cuid())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One-time admin invite link (24 hours).
model Invite {
  id        String    @id @default(cuid())
  email     String
  role      AdminRole @default(DEVELOPER)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // ip|email
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Editable home page (single row).
model HomeContent {
  id                Int      @id @default(1)
  heroEyebrow       String
  heroHeadline      String
  heroHeadlineEm    String
  heroSubcopy       String
  heroImageUrl      String?
  primaryCtaLabel   String   @default("Shop now")
  primaryCtaHref    String   @default("/shop")
  secondaryCtaLabel String   @default("Make it custom")
  secondaryCtaHref  String   @default("/custom")
  seasonalHeadline  String?
  seasonalImageUrl  String?
  seasonalFrom      DateTime?
  seasonalTo        DateTime?
  flowerHeadline    String
  flowerCopy        String
  flowerImageUrl    String?
  steps             Json // [{ title, text }] × 4
  updatedAt         DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  imageUrl  String? // WhatsApp screenshot, phone numbers blurred. Null = designed placeholder.
  caption   String // "First name, City"
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SocialTile {
  id        String @id @default(cuid())
  label     String // Reel | Post | TikTok
  href      String
  imageUrl  String?
  sortOrder Int    @default(0)
}
